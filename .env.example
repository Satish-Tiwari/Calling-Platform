# Application Server Configuration
PORT=3000
HTTPS_PORT=3443
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL Docker container)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=calling_platform

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_calling_platform_2026_xyz
JWT_EXPIRES_IN=7d

# Email SMTP Configuration (Nodemailer)
# Configure your SMTP credentials here to deliver real verification and password reset emails.
# If left empty, OTP codes are logged to the terminal console during development for easy testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Calling Platform <no-reply@callingplatform.com>"

# Application URLs
APP_URL=http://localhost:3000
APP_HTTPS_URL=https://192.168.43.72:3443
